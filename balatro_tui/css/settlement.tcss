SettlementPanel {
    width: 90%;
    padding: 1 2;
}

#cash_out {
    width: 100%;
    background: rgb(83, 83, 83);
    color: white;
    text-align: center;
}

/* compose 用的是 classes="settlement_row/row_label/row_amount",必须用类选择器 */
.settlement_row {
    height: 1;
    margin-top: 1;
}

.row_label {
    width: 70%;
}

.row_amount {
    width: 30%;
    text-align: right;
    color: rgb(255, 200, 0);
}

#settlement_divider {
    width: 100%;
    text-align: center;
}

#collect {
    width: 100%;
    margin-top: 1;
    text-align: center;
}

/* 紧凑模式(≤15 行):奖励行数多时也要保证【收下】在视口内可点 */
.compact SettlementPanel {
    padding: 0 2;
}

.compact .settlement_row {
    margin-top: 0;
}
