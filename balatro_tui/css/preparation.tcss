LeftContainer {
    width: 25%;
    border: heavy rgb(83, 83, 83);
}

RightContainer {
    width: 75%;
    border: heavy rgb(83, 83, 83);
}

#chips {
    width: 50%;
    text-align: right;
    border-right: rgb(83, 83, 83);
}

#mult {
    width: 50%;
    text-align: left;
}

#level, #require, #rewards, #score {
    width: 50%;
}

#level {
    border-right: rgb(83, 83, 83);
}

#rewards {
    border-right: rgb(83, 83, 83);
}

#info {
    width: 50%;
    height: 1;
    border-left: vkey rgb(83, 83, 83);
    border-right: vkey rgb(83, 83, 83);
    text-align: center;
    align: center middle;
}

PreparationButton:focus, FocusableStatic:focus {
    background: rgb(83, 83, 83);
    color: white;
}

PreparationButton {
    height: 1;
    min-width: 1;
    padding: 0 1;
    border: none;
}

JokerHorizontalScroll {
    width: 60%;
    scrollbar-visibility: hidden;

}

JokerHorizontalScroll:hover,
ConsumableHorizontalScroll:hover,
Tag:hover {
    background: rgb(83, 83, 83) 15%;
}

JokerHorizontalScroll:focus,
ConsumableHorizontalScroll:focus,
Tag:focus {
    background: rgb(83, 83, 83) 25%;
}

JokerHorizontalScroll Static {
    width: auto;
    border-right: rgb(83, 83, 83);
}

#joker_count {
    width: 10%;
    text-align: center;
    border-left: rgb(83, 83, 83);
    border-right: rgb(83, 83, 83);
}

ConsumableHorizontalScroll {
    width: 20%;
    scrollbar-visibility: hidden;
}

ConsumableHorizontalScroll Static {
    width: auto;
    border-right: rgb(83, 83, 83);
}

#consumable_count {
    width: 10%;
    text-align: center;
    border-left: rgb(83, 83, 83);
    border-right: rgb(83, 83, 83);
}

Tag {
    width: 10%;
    scrollbar-visibility: hidden;
    border: rgb(83, 83, 83);
}

Blind, Boss {
    border: rgb(83, 83, 83);
}

Blind Static {
    text-align: center;
}

Boss Static {
    text-align: center;
}

Blind Horizontal Static {
    width: 50%;
}

RightRow1 {
    height: 30%;
}
