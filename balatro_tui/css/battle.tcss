BattleArea {
    border: rgb(83, 83, 83);
}

#played_area {
    height: 1;
}

#played_area Static {
    width: auto;
    border-right: rgb(83, 83, 83);
    text-align: center;
}

HandHorizontalScroll {
    width: 90%;
    scrollbar-visibility: hidden;
    border: rgb(83, 83, 83);
}

HandHorizontalScroll Static {
    width: 10;
    height: 3;
    border-right: rgb(83, 83, 83);
    text-align: center;
    content-align: center middle;
}

ActionBar {
    height: 2;
    align-horizontal: center;
}

ActionBar Center {
    width: 25;
}

#sort_group {
    width: 24;
}

#sort_group Static {
    text-align: center;
}

#sort_buttons {
    align-horizontal: center;
}

HandHorizontalScroll Static.selected {
    background: rgb(120, 160, 220);
    color: black;
}

HandCard:hover {
    text-style: bold;
}

#played_area {
    height: auto;
    max-height: 8;
    overflow-y: auto;
    margin-bottom: 1;
}

ActionBar Center {
    width: 12;
}

/* 组内两枚按钮各占 12 列,组本身必须给足 24 列,否则「花色」被裁剪点不到 */
#sort_group {
    width: 24;
}

ActionBar PreparationButton {
    width: 100%;
}

/* 100% 会让组内两枚按钮各自撑满整组而溢出,用 1fr 平分 */
#sort_buttons PreparationButton {
    width: 1fr;
}

/* 紧凑模式(≤15 行):去掉提示行外距、手牌区收成卡片的固定高度,
   保证 13 行下手牌完整可见可点 */
.compact #played_area {
    margin-bottom: 0;
}

.compact HandHorizontalScroll {
    height: 5;
}
