#home-container {
    width: 100%;
    height: 100%;
    align: center middle;
    background: $background;
}

#buttons {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 1;
}

#start_btn, #collection_btn {
    width: 20;
    margin: 0 4;
    border: heavy rgb(83, 83, 83);
}

Header, Footer {
    background: #191a1c;
}

HomeScreen {
    background: #1e1f22;
}