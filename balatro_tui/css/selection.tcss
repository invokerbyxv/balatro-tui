#deck_select, #stake_select {
    width: 100%;
    height: 40%;
    align: center middle;
}

#deck_select Static,
#stake_select Static {
    width: 50%;
    text-align: center;
    border: solid rgb(83, 83, 83);
}

#deck_select Button,
#stake_select Button {
    border: solid rgb(83, 83, 83);
}

#deck_select:focus Static,
#stake_select:focus Static {
    border: solid $accent;
}