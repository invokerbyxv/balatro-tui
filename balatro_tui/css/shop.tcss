#shop_actions {
    width: 25%;
    padding: 1 1;
    border: heavy rgb(83, 83, 83);
    align: center middle;
}

#shop_actions PreparationButton {
    margin-bottom: 1;
}

ShopGoods {
    width: 75%;
    height: 100%;

}

ShopPanel {
    width: 90%;
}

GoodsRow, PackRow {
    height: 50%;
    align: center middle;
}

ShopPanel .item {
    width: 18;
    margin: 0 1;
}

ShopPanel .price {
    width: 100%;
    text-align: center;
    color: rgb(255, 200, 0);
}

ShopPanel FocusableStatic {
    width: 100%;
    height: 3;
    text-align: center;
    border: rgb(83, 83, 83);
}
